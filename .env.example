# Copy to .env and fill in. Names only here; never commit real values.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=

# PostgreSQL (docker compose creates the database from these)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Connections (SQLAlchemy URLs, e.g. postgresql+psycopg://USER:PASSWORD@HOST:5432/DB)
DATABASE_URL=
DATABASE_URL_OWNER=
DATABASE_URL_BASELINE_RO=
DATABASE_URL_SCORER=
DATABASE_URL_VERIFIER=

# Secrets (at least 32 characters each)
SESSION_SECRET=
BANK_HMAC_KEY=

# LLM: Gemini free tier only. Never link a billing account to this key's project.
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_PROVIDER=
LLM_MODE=
LLM_RPM=
LLM_RPD=
OLLAMA_URL=
OLLAMA_MODEL=

# Files and limits
DOCUMENT_STORE_PATH=
UPLOAD_MAX_BYTES=
FORENSICS_URL=
CHECKPOINT_RETENTION_DAYS=
SESSION_IDLE_HOURS=
DEMO_PASSWORD=
LOG_LEVEL=
