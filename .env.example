# Copy to .env and fill in. Names only here; never commit real values.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=

# PostgreSQL (docker compose creates the database from these).
# POSTGRES_USER is the schema owner and must be: opspilot_owner
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Connections (SQLAlchemy URLs: postgresql+psycopg://USER:PASSWORD@db:5432/DB).
# Each URL must use its fixed role name; `opspilot db provision-roles` enables login
# for these roles with the passwords given here (06-database.md §7):
#   DATABASE_URL              -> opspilot_app         (app and inference)
#   DATABASE_URL_OWNER        -> opspilot_owner       (migrations, roles, seed)
#   DATABASE_URL_BASELINE_RO  -> opspilot_baseline_ro (baseline SQL tool, read-only views)
#   DATABASE_URL_SCORER       -> opspilot_scorer      (dataset generation and scoring)
#   DATABASE_URL_VERIFIER     -> opspilot_verifier    (audit verify, read-only)
DATABASE_URL=
DATABASE_URL_OWNER=
DATABASE_URL_BASELINE_RO=
DATABASE_URL_SCORER=
DATABASE_URL_VERIFIER=

# Secrets (at least 32 characters each)
SESSION_SECRET=
BANK_HMAC_KEY=

# LLM: Gemini free tier only. Never link a billing account to this key's project.
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_PROVIDER=
LLM_MODE=
LLM_RPM=
LLM_RPD=
OLLAMA_URL=
OLLAMA_MODEL=

# Files and limits
DOCUMENT_STORE_PATH=
UPLOAD_MAX_BYTES=
FORENSICS_URL=
CHECKPOINT_RETENTION_DAYS=
SESSION_IDLE_HOURS=
DEMO_PASSWORD=
LOG_LEVEL=
